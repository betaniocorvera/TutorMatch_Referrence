# ============================================================
# TutorMatch backend configuration
# Copy this file to .env, then fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# Flask
# Generate with:
#   py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=false
PORT=5000

# Used to pepper OTP hashes. Generate a different value from SECRET_KEY.
OTP_PEPPER=replace-with-another-long-random-string

# Public URL used in password-reset emails.
APP_BASE_URL=http://127.0.0.1:5000

# MySQL
DB_HOST=127.0.0.1
# Use 3306 by default. Check your MySQL service if it uses another port.
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tutormatch

# Cookies
# Keep false for http://127.0.0.1 during the demo.
# Set true in production behind HTTPS.
COOKIE_SECURE=false

# Email — Gmail SMTP
# MAIL_DEV_MODE=false sends real email through smtp.gmail.com.
# MAIL_DEV_MODE=true only prints messages and writes outbox.log.
#
# MAIL_USERNAME = your full Gmail address (the sender).
# MAIL_PASSWORD = your 16-character Google App Password,
#                 NOT your normal Gmail password.
# MAIL_SENDER_NAME = the name shown in the From line.
MAIL_DEV_MODE=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=TutorMatch
MAIL_DEFAULT_SENDER="TutorMatch <no-reply@example.test>"
