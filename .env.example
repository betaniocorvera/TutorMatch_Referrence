# ============================================================
# TutorMatch backend configuration
# Copy this file to .env, then fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# Flask
# Generate with:
#   py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=false
PORT=5000

# Used to pepper OTP hashes. Generate a different value from SECRET_KEY.
OTP_PEPPER=replace-with-another-long-random-string

# Public URL used in password-reset emails.
APP_BASE_URL=http://127.0.0.1:5000

# MySQL
DB_HOST=127.0.0.1
# Use 3306 by default. Check your MySQL service if it uses another port.
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tutormatch

# Cookies
# Keep false for http://127.0.0.1 during the demo.
# Set true in production behind HTTPS.
COOKIE_SECURE=false

# Email
# MAIL_DEV_MODE=true prints OTPs and reset links to the terminal
# and appends them to outbox.log. No SMTP server is contacted.
MAIL_DEV_MODE=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="TutorMatch <no-reply@example.test>"
